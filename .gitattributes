# Keep line endings identical across Windows, macOS and Linux so diffs stay
# meaningful and shell scripts keep working on any contributor's machine.
* text=auto eol=lf

# Binary assets — never let git try to normalise these.
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary

# Lockfiles and generated types are committed as-is.
package-lock.json -diff linguist-generated=true
next-env.d.ts linguist-generated=true